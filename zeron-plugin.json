  "tools": [
    {
      "description": "Make or change a Design (Screens on a Canvas) by running a Luau snippet against it; returns the ids of the nodes it returned or kept in G (verbose = true: every new node's), what it printed, warnings and screenshots. Read the design guide first (design_guide, or the guide your first call returns).",
      "input": {
        "properties": {
          "description": {
            "description": "What this call does, in a few words (it names the undo step).",
            "type": "string"
          },
          "did": {
            "description": "The Design to change (a previous result's design.did, or one from design_state). With neither did nor name, the Design in your chat's front Design tab.",
            "type": "string"
          },
          "editId": {
            "description": "Retries the failed call with this edit id, its snippet changed by edits; send no snippet, did or name with it.",
            "type": "string"
          },
          "edits": {
            "description": "With editId: find-and-replace edits to the failed snippet, made in order; each find must be in it once.",
            "items": {
              "properties": {
                "find": {
                  "type": "string"
                },
                "replace": {
                  "type": "string"
                }
              },
              "required": [
                "find",
                "replace"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "name": {
            "description": "A name for a new Design.",
            "type": "string"
          },
          "snippet": {
            "description": "Luau calling Insert, Copy, Update, Replace, Move, Delete, Get, FindByName, FindAll, CheckFits, SetTokens, GetTokens, SetThemes, FindEmptySpace, TakeScreenshot and Print, as the design guide documents. Nodes are tables: { type = \"frame\", name = \"Card\", children = { ... } }.",
            "type": "string"
          },
          "verbose": {
            "description": "true: ids lists every node the call made, by name. By default it lists only those Insert/Copy/Replace returned and those the snippet kept in G or returned.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "design_execute"
    },
    {
      "description": "Lists the Designs open in your chat's Design tabs (the front one first), each with what the person has selected in it, and the ones touched recently.",
      "input": {
        "properties": {},
        "type": "object"
      },
      "name": "design_state"
    },
    {
      "description": "The design guide: the core guide without a topic, or a topic guide (components, design-systems, landing-pages, mobile-apps, web-apps, slides, tables, code, tailwind).",
      "input": {
        "properties": {
          "topic": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "design_guide"
    }
  ],
  "version": "0.6.2"
